rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Default deny all unhandled paths
    match /{document=**} {
      allow read, write: if false;
    }

    // Public read for timetables so teachers and students can view schedules instantly
    // Writes permitted for admins/users updating schedules
    match /timetables/{timetableId} {
      allow read: if true;
      allow write: if true;
    }

    // Global config settings
    match /config/{configId} {
      allow read: if true;
      allow write: if true;
    }

    // Master School Settings & Timings Sync
    match /school_settings/{settingsId} {
      allow read: if true;
      allow write: if true;
    }
  }
}
